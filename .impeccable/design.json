  "narrative": {
    "northStar": "La continuidad",
    "overview": "Una emisión termina y la siguiente tiene nombre y hora. Relevo toma de la programación de radio nocturna su continuidad, su precisión horaria y su lectura serena, no la apariencia de una radio. Es una herramienta de trabajo: botones, campos, listas y navegación web reconocibles.",
    "keyCharacteristics": [
      "Jerarquía por tipografía, espacios y alineación, no por cajas dentro de cajas.",
      "Una acción primaria por paso; interacción convencional antes que expresión visual.",
      "Un único gesto de identidad: continuidad entre saliente y entrante, sin fingir cobertura."
    ],
    "rules": [
      { "name": "Regla de continuidad honesta", "body": "Enviar no cierra el traspaso visual. La cobertura efectiva solo se muestra al comenzar su ventana; una línea unida nunca prueba por sí sola cobertura activa.", "section": "overview" },
      { "name": "Regla del ocre escaso", "body": "La acción primaria debe seguir siendo lo más fácil de encontrar; no colorear de ocre cada fila ni cada estado.", "section": "colors" },
      { "name": "Regla de estado explícito", "body": "Los estados se distinguen por etiquetas y estructura; la confirmación verde solo aparece tras un evento de aceptación o cobertura efectiva.", "section": "colors" }
    ],
    "dos": [
      "Do mantener Public Sans, petróleo mate, texto claro y ocre concentrado en acción.",
      "Do terminar cada operación en el estado observado, incluso si es Sin cobertura confirmada."
    ],
    "donts": [
      "Don't usar Inter, gradientes morados, brillo, transparencias ornamentales o bajo contraste.",
      "Don't mostrar un chip verde, una línea cerrada o «Todo listo» por el mero envío del relevo.",
      "Don't confundir Aceptar relevo con Tomar incidente ni acuse con resolución."
