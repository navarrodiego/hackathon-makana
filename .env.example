# Copia a .env. No publiques valores. La página inicial no necesita credenciales.
# PostgreSQL local: una base y un rol privado por entorno.
DATABASE_URL=
# Conexión directa de migración. Debe apuntar a la misma base que DATABASE_URL.
DIRECT_URL=
# Integraciones previstas, aún sin implementación.
OPENROUTER_API_KEY=
NTFY_ENABLED=false
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=
CONTROL_SECRET=

# Bases locales dedicadas de pruebas; sin credenciales compartidas con desarrollo.
RELEVO_BACKEND_TEST_URL=
RELEVO_BACKEND_TEST_ISOLATION_URL=

# Solo para preparar un servidor local nuevo; nunca usar en la app.
LOCAL_POSTGRES_ADMIN_URL=
