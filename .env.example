# Copia a .env. No publiques valores. La página inicial no necesita credenciales.
# PostgreSQL local: una base y un rol privado por entorno.
DATABASE_URL=
# Conexión directa de migración. Debe apuntar a la misma base que DATABASE_URL.
DIRECT_URL=
# Integraciones previstas, aún sin implementación.
OPENROUTER_API_KEY=
NTFY_ENABLED=false
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=

# Acceso de operador (C12): una sola contraseña para /rodrigo y /control, mínimo 12 caracteres.
# El rol lo fija la página donde se ingresa. Sin ella, nadie entra. Cambiarla cierra todas las sesiones.
OPERATOR_SECRET=
# Origen exacto de la app (sin barra final). Debe coincidir con el host que abres: 127.0.0.1 y localhost son distintos.
APP_ORIGIN=http://127.0.0.1:3000
# Opcional: tiempo máximo de ntfy en ms.
# NTFY_TIMEOUT_MS=

# Escritas por `pnpm db:worktree` (base propia del worktree y sus dos bases de pruebas); sin credenciales compartidas.
RELEVO_BACKEND_URL=
RELEVO_BACKEND_DIRECT_URL=
RELEVO_BACKEND_TEST_URL=
RELEVO_BACKEND_TEST_DIRECT_URL=
RELEVO_BACKEND_TEST_ISOLATION_URL=
RELEVO_BACKEND_TEST_ISOLATION_DIRECT_URL=

# Solo para preparar un servidor local nuevo; nunca usar en la app.
LOCAL_POSTGRES_ADMIN_URL=
