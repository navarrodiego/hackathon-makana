{
  "name": "relevo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.11.0 <25",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "pnpm db:generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:check": "tsx scripts/check-db.ts",
    "db:migrate:local": "tsx scripts/db/migrate.ts",
    "db:seed:local": "node --conditions=react-server --import tsx scripts/db/seed.ts",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:db": "node --conditions=react-server --import tsx --test --test-concurrency=1 tests/db/*.test.ts",
    "test": "pnpm test:unit && pnpm test:db",
    "db:prepare:local": "tsx scripts/db/provision.ts",
    "db:worktree:up": "bash scripts/worktree/db-up.sh",
    "db:worktree:setup": "bash scripts/worktree/setup.sh",
    "wt:db:prune": "bash scripts/worktree/db-prune.sh",
    "wt:remove": "bash scripts/worktree/remove.sh"
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "5.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "clsx": "2.1.1",
    "dotenv": "18.0.8",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "postcss": "8.5.31",
    "prisma": "7.10.1",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
